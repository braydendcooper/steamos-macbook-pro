# SteamOS on the MacBook Neo: options SteamOS userspace relies on, on top of
# defconfig + asahi.config + gravity.config + gravity-aarch64.config.
# Chosen by comparing against Valve's Steam Frame kernel (6.18.0, SteamOS 0.3.0)
# and keeping what SteamOS boot, Steam, Proton and FEX use; hardware-specific
# and server/networking-only options are left out.

# --- Boot: initramfs mounts the slot's FAT efi partition to read partsets,
# --- then btrfs rootfs with an overlayfs /etc (etc_overlay hook).
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_UTF8=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_AUTOFS_FS=y
CONFIG_UNICODE=y

# --- Display: KMS on the boot framebuffer (no GPU driver for the A18 Pro yet).
# efifb would grab the same framebuffer as fbdev-only; simpledrm gives KMS.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
# CONFIG_FB_EFI is not set
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# --- Steam Input and controllers.
CONFIG_INPUT_UINPUT=m
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HIDRAW=y
CONFIG_UHID=m
CONFIG_USB_HIDDEV=y
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y
CONFIG_HID_SONY=m
CONFIG_SONY_FF=y
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_MICROSOFT=m
CONFIG_HID_PID=y

# --- Games: FEX registers x86 handlers via binfmt_misc; Proton uses ntsync.
CONFIG_BINFMT_MISC=m
CONFIG_NTSYNC=m
CONFIG_USERFAULTFD=y

# --- System services: systemd-oomd needs PSI; zram swap; removable media.
CONFIG_PSI=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m

# --- Valve runs SteamOS at 1000 Hz.
CONFIG_HZ_1000=y

# --- U-Boot starts the Apple watchdog (60 s) and leaves it running; the kernel
# --- must service it from early boot (WATCHDOG_HANDLE_BOOT_ENABLED), not only
# --- once a module loads from the real root, or the Neo resets mid-boot.
CONFIG_APPLE_WATCHDOG=y

# Build natively on arm64 using the existing Ubuntu 24.04 / glibc 2.39 image.
FROM neo-mesa-noble:1

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      pkg-config libasound2-dev lv2-dev libsndfile1-dev libcairo2-dev \
      g++ make ca-certificates git binutils python3 curl tar zstd \
    && rm -rf /var/lib/apt/lists/*

# Use Noble's GCC rather than the Mesa image's inherited Clang defaults.
ENV CC=gcc CXX=g++
WORKDIR /src/aurora
CMD ["bash"]

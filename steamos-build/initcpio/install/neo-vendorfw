#!/bin/bash

build() {
    # base supplies busybox and its cpio, tr, cp, sleep, etc. applets.
    # SteamOS's BusyBox has no mount applet. Include rm for staging cleanup too.
    add_binary mount
    add_binary rm
    # BusyBox blkid does not implement util-linux's PARTUUID lookup options.
    add_binary /usr/bin/blkid

    # add_module handles modules built into the kernel without error.
    add_module vfat
    add_module nls_cp437
    add_module nls_iso8859-1

    # The ESP must be accessible before udev's coldplug. These are optional
    # because some Neo kernels build the Apple storage support in directly.
    add_module 'apple-mailbox?'
    add_module 'nvme-apple?'

    add_dir /lib/firmware/vendor
    add_runscript
}

help() {
    cat <<'EOF'
Load this Mac's vendor firmware from the device-tree-selected EFI system
partition before udev coldplug, then copy it to a tmpfs on the mounted root.
For the BusyBox base/udev initramfs: put neo-vendorfw immediately after base
and before udev in HOOKS. Requires vendorfw/firmware.cpio on the ESP and an
existing /usr/lib/firmware/vendor directory in the SteamOS image.
Runtime failures are reported and never abort boot.
EOF
}

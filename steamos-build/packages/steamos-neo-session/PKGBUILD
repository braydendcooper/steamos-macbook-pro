pkgname=steamos-neo-session
pkgver=1
pkgrel=9
pkgdesc='Flat Gamescope and Plasma sessions for the M1 Pro MacBook Pro'
arch=(any)
license=(MIT BSD-2-Clause)
options=(!strip !debug)
replaces=(deckard-steamvr-session)
conflicts=(deckard-steamvr-session)
backup=(etc/sddm.conf.d/steamos.conf etc/steamos-neo/session.conf)
# All package inputs are local, referenced through $startdir below.
source=()
sha256sums=()

package() {
    cp -a "$startdir/usr" "$startdir/etc" "$pkgdir/"
    chmod 755 "$pkgdir/usr/bin/"* "$pkgdir/usr/lib/steamos/"* \
        "$pkgdir/usr/lib/steamos-neo/"*
    install -Dm644 "$startdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$startdir/LICENSE.steamos-powerbuttond" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.steamos-powerbuttond"
    install -Dm644 "$startdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}

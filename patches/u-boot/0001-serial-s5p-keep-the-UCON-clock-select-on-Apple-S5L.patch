From ea962ab2f086f4870f691afeae4a74e64475e1f7 Mon Sep 17 00:00:00 2001
From: ufdmedia <247953355+ufdmedia@users.noreply.github.com>
Date: Fri, 2 Oct 2026 00:00:00 +0000
Subject: [PATCH 1/2] serial: s5p: keep the UCON clock select on Apple S5L

s5p_serial_init() writes UCON outright, clearing bit 10, which on the
MacBook Neo (t8140) selects the firmware-configured UART clock; the baud
clock then changes and output is garbled. Preserve it on Apple, as Linux
needs too (tty: serial: samsung: keep UCON clock select on Apple S5L).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/serial/serial_s5p.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/drivers/serial/serial_s5p.c b/drivers/serial/serial_s5p.c
index d46a8861..c2b61dd2 100644
--- a/drivers/serial/serial_s5p.c
+++ b/drivers/serial/serial_s5p.c
@@ -33,6 +33,8 @@ enum {
 #define UCON_TX_IRQ_OR_POLLING	BIT(2)
 #define UCON_RX_ERR_IRQ_EN	BIT(6)
 #define UCON_TX_IRQ_LEVEL	BIT(9)
+/* Apple S5L: firmware-selected UART clock; clearing it changes the baud clock (t8140). */
+#define S5L_UCON_CLKSEL		BIT(10)
 
 #define S5L_RX_FIFO_COUNT_SHIFT	0
 #define S5L_RX_FIFO_COUNT_MASK	(0xf << S5L_RX_FIFO_COUNT_SHIFT)
@@ -87,7 +89,7 @@ static const int udivslot[] = {
 	0xffdf,
 };
 
-static void __maybe_unused s5p_serial_init(struct s5p_uart *uart)
+static void __maybe_unused s5p_serial_init(struct s5p_uart *uart, u32 ucon_keep)
 {
 	/* Enable FIFOs, auto clear Rx FIFO */
 	writel(UFCON_FIFO_EN | UFCON_RX_FIFO_RESET, &uart->ufcon);
@@ -96,7 +98,8 @@ static void __maybe_unused s5p_serial_init(struct s5p_uart *uart)
 	/* 8N1, no parity bit */
 	writel(ULCON_WORD_8_BIT, &uart->ulcon);
 	/* No interrupts, no DMA, pure polling */
-	writel(UCON_RX_IRQ_OR_POLLING | UCON_TX_IRQ_OR_POLLING |
+	writel((readl(&uart->ucon) & ucon_keep) |
+	       UCON_RX_IRQ_OR_POLLING | UCON_TX_IRQ_OR_POLLING |
 	       UCON_RX_ERR_IRQ_EN | UCON_TX_IRQ_LEVEL, &uart->ucon);
 }
 
@@ -146,7 +149,8 @@ static int s5p_serial_probe(struct udevice *dev)
 	struct s5p_serial_plat *plat = dev_get_plat(dev);
 	struct s5p_uart *const uart = plat->reg;
 
-	s5p_serial_init(uart);
+	s5p_serial_init(uart, dev_get_driver_data(dev) == PORT_S5L ?
+			      S5L_UCON_CLKSEL : 0);
 
 	return 0;
 }
@@ -285,7 +289,7 @@ static inline void _debug_uart_init(void)
 
 	struct s5p_uart *uart = (struct s5p_uart *)CONFIG_VAL(DEBUG_UART_BASE);
 
-	s5p_serial_init(uart);
+	s5p_serial_init(uart, IS_ENABLED(CONFIG_ARCH_APPLE) ? S5L_UCON_CLKSEL : 0);
 #if IS_ENABLED(CONFIG_ARCH_APPLE)
 	s5p_serial_baud(uart, 4, CONFIG_DEBUG_UART_CLOCK, CONFIG_BAUDRATE);
 #else
-- 
